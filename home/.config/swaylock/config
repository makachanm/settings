# 폰트 및 기본 동작
font=monospace
font-size=14
ignore-empty-password
show-failed-attempts

# 배경 설정 (어두운 반투명)
color=1e1e1eF0

# 인디케이터 크기 및 형태 설정 (직각 사각형 형태)
